NODE_ENV=development
PORT=8080

# PostgreSQL (Railway provides DATABASE_URL)
DATABASE_URL=postgres://user:password@host:5432/dbname

# JWT
JWT_SECRET=replace-with-strong-random-64-chars
JWT_REFRESH_SECRET=replace-with-another-strong-random-64-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (Vercel frontend)
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN.vercel.app

# Firebase (Spark plan)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Behavior
PAIRING_CODE_TTL_SECONDS=300
INVITATION_DEFAULT_TTL_SECONDS=86400
MONITORING_SESSION_TTL_SECONDS=3600
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=90
